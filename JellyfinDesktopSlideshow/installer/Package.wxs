<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Jellyfin Desktop Slideshow"
           Manufacturer="Jellyfin Desktop Slideshow Contributors"
           Version="$(var.AppVersion)"
           UpgradeCode="A7C4F9B2-6E31-4D8A-9C1B-2E7F4A5B8D01"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="نسخهٔ جدیدتر [ProductName] هم‌اکنون نصب است." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <Feature Id="MainFeature" Title="Jellyfin Desktop Slideshow" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="MainExecutableComponent" />
      <ComponentRef Id="InstallMarkerComponent" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Jellyfin Desktop Slideshow" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**">
        <Exclude Files="$(var.PayloadDir)\JellyfinDesktopSlideshow.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="MainExecutableComponent"
               Directory="INSTALLFOLDER"
               Guid="C3E8A41F-9B52-4F6D-8A10-5C7E9B2D3F40">
      <File Id="JellyfinDesktopSlideshowExe"
            Source="$(var.PayloadDir)\JellyfinDesktopSlideshow.exe"
            KeyPath="yes">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="Jellyfin Desktop Slideshow"
                  Description="اسلایدشوی دسکتاپ تصاویر پس‌زمینه Jellyfin"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="yes" />
      </File>
    </Component>

    <Component Id="InstallMarkerComponent"
               Directory="INSTALLFOLDER"
               Guid="D4F9B520-A163-4E7C-9B21-6D8F0C3E4A51">
      <RegistryValue Root="HKLM"
                     Key="Software\JellyfinDesktopSlideshow"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
