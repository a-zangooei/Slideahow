<Window x:Class="JellyfinDesktopSlideshow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JellyfinDesktopSlideshow.Views"
        xmlns:loc="clr-namespace:JellyfinDesktopSlideshow.Localization"
        Title="{Binding [Settings.WindowTitle], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
        Width="820"
        Height="650"
        MinWidth="700"
        MinHeight="540"
        FlowDirection="{Binding CurrentFlowDirection, Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:DynamicTextFlowDirectionConverter x:Key="DynamicFlowDirection" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE2EA">
            <!-- 1. Server Connection -->
            <TabItem Header="{Binding [Settings.Tab1.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="580" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [Settings.Tab1.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [Settings.Tab1.ServerUrlLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight"
                                 Padding="8,6"
                                 Margin="0,0,0,10"
                                 ToolTip="{Binding [Settings.Tab1.ServerUrlToolTip], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" />

                        <TextBlock Text="{Binding [Settings.Tab1.AuthMethodLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AuthMethodOptions}"
                                  SelectedValue="{Binding SelectedAuthMethod}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  Padding="8,5"
                                  Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsApiKeyAuthSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding [Settings.Tab1.ApiKeyLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <PasswordBox x:Name="ApiKeyInput"
                                         FlowDirection="LeftToRight"
                                         Padding="8,6"
                                         Margin="0,0,0,8"
                                         ToolTip="{Binding [Settings.Tab1.ApiKeyToolTip], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" />

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <TextBlock Text="{Binding [Settings.Tab1.ApiKeyInfo], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                           Foreground="#1E3A8A"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsPasswordAuthSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding [Settings.Tab1.UsernameLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     FlowDirection="LeftToRight"
                                     Padding="8,6"
                                     Margin="0,0,0,10" />

                            <TextBlock Text="{Binding [Settings.Tab1.PasswordLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <PasswordBox x:Name="PasswordInput"
                                         FlowDirection="LeftToRight"
                                         Padding="8,6"
                                         Margin="0,0,0,12" />
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="{Binding [Settings.Tab1.TestConnectionButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding TestConnectionCommand}"
                                    Padding="14,7"
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding [Settings.Tab1.ConnectApiKeyButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Click="ConnectWithApiKeyButton_Click"
                                    Visibility="{Binding IsApiKeyAuthSelected, Converter={StaticResource BoolToVisibility}}"
                                    Padding="16,7"
                                    FontWeight="SemiBold"
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding [Settings.Tab1.LoginButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Click="LoginButton_Click"
                                    Visibility="{Binding IsPasswordAuthSelected, Converter={StaticResource BoolToVisibility}}"
                                    Padding="16,7"
                                    FontWeight="SemiBold"
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding [Settings.Tab1.LogoutButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding LogoutCommand}"
                                    Padding="14,7" />
                        </WrapPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding [Settings.Tab1.StatusPrefix], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="{Binding ServerDetails}" Foreground="#475569" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SecurityWarning}" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Libraries & Media -->
            <TabItem Header="{Binding [Settings.Tab2.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding [Settings.Tab2.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="{Binding [Settings.Tab2.IncludeMovies], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" IsChecked="{Binding IncludeMovies}" Margin="0,0,18,0" />
                        <CheckBox Content="{Binding [Settings.Tab2.IncludeSeries], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" IsChecked="{Binding IncludeSeries}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="{Binding ItemsSummary}" Foreground="#334155" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="{Binding [Settings.Tab2.RefreshLibrariesButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding LoadLibrariesCommand}"
                                    Padding="14,7"
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding [Settings.Tab2.ApplyFilterButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding ApplyMediaSelectionCommand}"
                                    Padding="16,7"
                                    FontWeight="SemiBold" />
                        </WrapPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Libraries}" BorderBrush="#CBD5E1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FlowDirection="{Binding Name, Converter={StaticResource DynamicFlowDirection}}"
                                                   FontWeight="Medium" />
                                        <TextBlock Text="{Binding CollectionType, StringFormat=' ({0})'}"
                                                   FlowDirection="LeftToRight"
                                                   Foreground="#64748B"
                                                   FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- 3. Slideshow & Wallpaper -->
            <TabItem Header="{Binding [Settings.Tab3.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="580" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [Settings.Tab3.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings.Tab3.IntervalLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SlideshowIntervalSeconds, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Settings.Tab3.NonRepeatLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NonRepeatHistoryCount, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />
                        </Grid>

                        <CheckBox Content="{Binding [Settings.Tab3.RandomOrder], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding IsRandomOrder}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [Settings.Tab3.OfflineBehaviorLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding OfflineBehaviorOptions}"
                                  SelectedValue="{Binding SelectedOfflineBehavior}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  Padding="8,5"
                                  Margin="0,0,0,16" />

                        <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <CheckBox Content="{Binding [Settings.Tab3.ApplyToWallpaper], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                          IsChecked="{Binding ApplyToDesktopWallpaper}"
                                          Margin="0,0,0,8" />

                                <TextBlock Text="{Binding [Settings.Tab3.FitModeLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding WallpaperFitModes}"
                                          SelectedValue="{Binding SelectedWallpaperFitMode}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          Padding="8,5"
                                          Margin="0,0,0,10" />

                                <CheckBox Content="{Binding [Settings.Tab3.RestoreOnExit], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                          IsChecked="{Binding RestoreWallpaperOnExit}"
                                          Margin="0,0,0,8" />

                                <TextBlock Text="{Binding MonitorsSummary}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. Desktop Icon -->
            <TabItem Header="{Binding [Settings.Tab4.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [Settings.Tab4.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [Settings.Tab4.ModeLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DesktopIconModes}"
                                  SelectedValue="{Binding SelectedDesktopIconMode}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  Padding="8,5"
                                  Margin="0,0,0,10" />

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <TextBlock Text="{Binding [Settings.Tab4.ShortcutNote], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                       Foreground="#475569"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{Binding [Settings.Tab4.OverlaySettingsLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <Grid IsEnabled="{Binding IsFloatingOverlayEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings.Tab4.OverlayLeftLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OverlayLeft, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Settings.Tab4.OverlayTopLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OverlayTop, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Settings.Tab4.OverlaySizeLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OverlaySize, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [Settings.Tab4.OverlayOpacityLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OverlayOpacity, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />
                        </Grid>

                        <TextBlock Text="{Binding [Settings.Tab4.OverlayNote], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. Launch Target -->
            <TabItem Header="{Binding [Settings.Tab5.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="580" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [Settings.Tab5.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [Settings.Tab5.TargetLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PlaybackTargetOptions}"
                                  SelectedValue="{Binding SelectedPlaybackTargetType}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  Padding="8,5"
                                  Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsCustomUrlTargetSelected, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                            <TextBlock Text="{Binding [Settings.Tab5.CustomUrlLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CustomUrlTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     FlowDirection="LeftToRight"
                                     Padding="8,6"
                                     ToolTip="{Binding [Settings.Tab5.CustomUrlToolTip], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" />
                            <TextBlock Text="{Binding [Settings.Tab5.AllowedVariables], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding CustomUrlValidationMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <TextBlock Text="{Binding [Settings.Tab5.DesktopClientNote], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                       Foreground="#475569"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6. Cache & Fallback -->
            <TabItem Header="{Binding [Settings.Tab6.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="580" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [Settings.Tab6.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings.Tab6.MaxCacheSizeLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxCacheSizeMb, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Settings.Tab6.MaxCacheAgeLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxCacheAgeDays, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Settings.Tab6.PreferredBackdropLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BackdropIndexPreference, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />
                        </Grid>

                        <CheckBox Content="{Binding [Settings.Tab6.RandomBackdrop], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding RandomBackdropPerItem}"
                                  Margin="0,0,0,12" />

                        <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding [Settings.Tab6.AspectFilterTitle], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <CheckBox Content="{Binding [Settings.Tab6.FilterAspectRatios], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                          IsChecked="{Binding FilterNonWallpaperAspectRatios}"
                                          Margin="0,0,0,8" />

                                <TextBlock Text="{Binding [Settings.Tab6.AspectPresetLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding BackdropAspectFilterPresets}"
                                          SelectedValue="{Binding SelectedBackdropAspectFilterPreset}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Value"
                                          IsEnabled="{Binding FilterNonWallpaperAspectRatios}"
                                          Padding="8,5"
                                          Margin="0,0,0,10" />

                                <Grid IsEnabled="{Binding IsCustomAspectRatioEnabled}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Settings.Tab6.MinAspectLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MinBackdropAspectRatio, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Settings.Tab6.MaxAspectLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxBackdropAspectRatio, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" Padding="6,4" />
                                </Grid>

                                <TextBlock Text="{Binding [Settings.Tab6.AspectFilterNote], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CacheSummary}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="{Binding [Settings.Tab6.PruneCacheButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding PruneCacheCommand}"
                                    Padding="12,6"
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding [Settings.Tab6.ClearCacheButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding ClearCacheCommand}"
                                    Padding="12,6" />
                        </WrapPanel>

                        <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding [Settings.Tab6.FallbackImageLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FallbackImagePath, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FlowDirection="LeftToRight"
                                         Padding="6,5"
                                         Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="{Binding [Settings.Tab6.SelectFallbackButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                            Click="SelectFallbackButton_Click"
                                            Padding="12,6"
                                            Margin="0,0,8,0" />
                                    <Button Content="{Binding [Settings.Tab6.ClearFallbackButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                            Command="{Binding ClearFallbackImageCommand}"
                                            Padding="12,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 7. Language & Startup -->
            <TabItem Header="{Binding [Settings.Tab7.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="580" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding [Settings.Tab7.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding [Settings.Tab7.LanguageLabel], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                  SelectedValue="{Binding SelectedLanguageCode}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="NativeName"
                                  MaxWidth="280"
                                  HorizontalAlignment="Left"
                                  Padding="8,5"
                                  Margin="0,0,0,8" />

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                            <TextBlock Text="{Binding [Settings.Tab7.LanguageHint], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                       Foreground="#1E3A8A"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <CheckBox Content="{Binding [Settings.Tab7.StartupCheck], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding LaunchOnWindowsStartup}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="{Binding [Settings.Tab7.StartMinimizedCheck], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding StartMinimizedToTray}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="{Binding [Settings.Tab7.MinimizeOnCloseCheck], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding MinimizeToTrayOnClose}"
                                  Margin="0,0,0,14" />

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <TextBlock Text="{Binding [Settings.Tab7.StorageInfo], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                       Foreground="#475569"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 8. Cleanup & Footprints -->
            <TabItem Header="{Binding [Settings.Tab8.Header], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left" IsEnabled="{Binding CleanupAvailable}">
                        <TextBlock Text="{Binding [Settings.Tab8.Title], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding [Settings.Tab8.Description], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                   Foreground="#475569"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [Settings.Tab8.FootprintHeader], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding [Settings.Tab8.RefreshFootprintButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                            Command="{Binding RefreshFootprintCommand}"
                                            Padding="10,4" />
                                </Grid>
                                <TextBlock Text="{Binding CleanupCacheSummaryLine}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock Text="{Binding CleanupHiddenSummaryLine}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock Text="{Binding CleanupOsSummaryLine}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock Text="{Binding CleanupRootSummaryLine}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [Settings.Tab8.OptionsHeader], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <CheckBox Content="{Binding [Settings.Tab8.OptImageCache], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding CleanBackdropCache}"
                                  Margin="0,0,0,6" />
                        <CheckBox Content="{Binding [Settings.Tab8.OptLogsAndHidden], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding CleanLogsAndHiddenFiles}"
                                  Margin="0,0,0,6" />
                        <CheckBox Content="{Binding [Settings.Tab8.OptCredentials], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding CleanCredentialsAndSession}"
                                  Margin="0,0,0,6" />
                        <CheckBox Content="{Binding [Settings.Tab8.OptOsTraces], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding CleanOsTraces}"
                                  Margin="0,0,0,6" />
                        <CheckBox Content="{Binding [Settings.Tab8.OptRestoreWallpaper], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding RestoreOriginalWallpaperOnCleanup}"
                                  Margin="20,0,0,6" />
                        <CheckBox Content="{Binding [Settings.Tab8.OptResetSettings], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                  IsChecked="{Binding CleanResetSettingsFile}"
                                  Margin="0,0,0,14" />

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="{Binding [Settings.Tab8.QuickCacheButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding QuickClearImageCacheCommand}"
                                    Padding="12,6"
                                    Margin="0,0,8,6" />
                            <Button Content="{Binding [Settings.Tab8.QuickHiddenButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Command="{Binding QuickClearLogsAndHiddenCommand}"
                                    Padding="12,6"
                                    Margin="0,0,8,6" />
                            <Button Content="{Binding [Settings.Tab8.CleanSelectedButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Click="CleanSelectedButton_Click"
                                    Padding="14,6"
                                    FontWeight="SemiBold"
                                    Margin="0,0,8,6" />
                            <Button Content="{Binding [Settings.Tab8.FullWipeButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                    Click="FullWipeButton_Click"
                                    Background="#B91C1C"
                                    Foreground="#FFFFFF"
                                    BorderBrush="#991B1B"
                                    Padding="14,6"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,6" />
                        </WrapPanel>

                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding [Settings.Tab8.FullWipeWarning], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                                       Foreground="#991B1B"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#0F766E" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="12" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 Margin="0,0,10,0" />
                    <Button Content="{Binding [Settings.CloseButton], Source={x:Static loc:AppLocalization.Current}, Mode=OneWay}"
                            Click="CloseButton_Click"
                            Padding="18,6"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
