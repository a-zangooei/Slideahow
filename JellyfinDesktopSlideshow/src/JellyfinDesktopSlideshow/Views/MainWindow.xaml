<Window x:Class="JellyfinDesktopSlideshow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JellyfinDesktopSlideshow.Views"
        Title="Jellyfin Desktop Slideshow"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:LocalPathToBitmapImageConverter x:Key="PathToImage" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- نوار وضعیت و دکمه‌های اصلی -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="وضعیت اتصال: " FontWeight="SemiBold" Foreground="#334155" />
                        <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold" Foreground="#0F172A" />
                    </StackPanel>
                    <TextBlock Text="{Binding ServerDetails}" Foreground="#475569" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SecurityWarning}" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="12" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 Margin="0,0,10,0" />
                    <Button Content="تنظیمات"
                            Command="{Binding OpenSettingsCommand}"
                            Padding="14,7"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0" />
                    <Button Content="کوچک‌کردن در Tray"
                            Command="{Binding MinimizeToTrayCommand}"
                            Padding="12,7"
                            Margin="0,0,8,0" />
                    <Button Content="خروج کامل"
                            Command="{Binding ExitApplicationCommand}"
                            Padding="12,7" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ورود سریع در صورت متصل نبودن -->
        <Border Grid.Row="1"
                Visibility="{Binding NeedsQuickLogin, Converter={StaticResource BoolToVisibility}}"
                Background="#FFFFFF"
                BorderBrush="#DCE2EA"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="آدرس سرور Jellyfin" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             FlowDirection="LeftToRight"
                             Padding="8,6"
                             ToolTip="مثال: http://192.168.1.10:8096" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="نام کاربری" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             FlowDirection="LeftToRight"
                             Padding="8,6" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="رمز عبور" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordInput"
                                 FlowDirection="LeftToRight"
                                 Padding="8,6" />
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="تست اتصال"
                            Command="{Binding TestConnectionCommand}"
                            Padding="12,7"
                            Margin="0,0,8,0" />
                    <Button Content="ورود"
                            Click="LoginButton_Click"
                            Padding="16,7"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- نمای اصلی: فهرست رسانه‌ها + پیش‌نمایش و کنترل اسلایدشو -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="6" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left"
                                Content="بروزرسانی فهرست"
                                Command="{Binding RefreshMediaCommand}"
                                Padding="10,5" />
                        <TextBlock Text="عنوان‌های فعال اسلایدشو"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding MediaItems}"
                              SelectedItem="{Binding SelectedMediaItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام عنوان" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding Type}" Width="75" />
                            <DataGridTextColumn Header="سال" Binding="{Binding ProductionYear}" Width="65" />
                            <DataGridCheckBoxColumn Header="Backdrop" Binding="{Binding HasBackdrop, Mode=OneWay}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="6" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PreviewTitle}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="شناسهٔ عنوان: " FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="{Binding CurrentSlideItemId}" FontSize="11" Foreground="#0F172A" FlowDirection="LeftToRight" />
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewStatus}" Foreground="#475569" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="شروع اسلایدشو"
                                    Command="{Binding StartSlideshowCommand}"
                                    Padding="12,6"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,4" />
                            <Button Content="{Binding PauseResumeButtonText}"
                                    Command="{Binding TogglePauseCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,4" />
                            <Button Content="قبلی"
                                    Command="{Binding PreviousSlideCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,4" />
                            <Button Content="بعدی"
                                    Command="{Binding NextSlideCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,4" />
                            <Button Content="باز کردن عنوان فعلی"
                                    Command="{Binding OpenCurrentItemCommand}"
                                    Padding="12,6"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,4" />
                            <Button Content="اعمال روی والپیپر"
                                    Command="{Binding ApplyCurrentWallpaperCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,4" />
                            <Button Content="{Binding OverlayToggleButtonText}"
                                    Command="{Binding ToggleOverlayCommand}"
                                    Padding="12,6"
                                    Margin="0,0,6,4" />
                            <Button Content="باز کردن در مرورگر"
                                    Command="{Binding OpenFallbackBrowserCommand}"
                                    Visibility="{Binding HasPendingFallbackBrowserUrl, Converter={StaticResource BoolToVisibility}}"
                                    Padding="12,6"
                                    Margin="0,0,0,4" />
                        </WrapPanel>

                        <TextBlock Text="{Binding LaunchStatus}" Foreground="#0F766E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding WallpaperStatus}" Foreground="#0F172A" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MonitorsSummary}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
                        <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImage}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- نوار خلاصه پایین -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CacheSummary}" Foreground="#64748B" FontSize="12" />
                <TextBlock Text="{Binding ItemsSummary}" Foreground="#334155" HorizontalAlignment="Left" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
