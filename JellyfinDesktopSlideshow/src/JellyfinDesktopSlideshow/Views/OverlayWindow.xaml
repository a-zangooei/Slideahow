<Window x:Class="JellyfinDesktopSlideshow.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jellyfin Overlay Icon"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Button Command="{Binding OpenCurrentItemCommand}"
            Width="{Binding OverlaySize}"
            Height="{Binding OverlaySize}"
            Opacity="{Binding OverlayOpacity}"
            ToolTip="{Binding ToolTipText}"
            Cursor="Hand"
            BorderThickness="0"
            Background="Transparent"
            Padding="0"
            FocusVisualStyle="{x:Null}">
        <Button.ContextMenu>
            <ContextMenu FlowDirection="RightToLeft">
                <MenuItem Header="باز کردن عنوان فعلی در Jellyfin"
                          Command="{Binding PlacementTarget.DataContext.OpenCurrentItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="ساخت / به‌روزرسانی میان‌بُر دسکتاپ"
                          Command="{Binding PlacementTarget.DataContext.CreateOrUpdateDesktopShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="مخفی کردن آیکون شناور"
                          Command="{Binding PlacementTarget.DataContext.HideOverlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
        </Button.ContextMenu>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="RootBadge"
                        CornerRadius="48"
                        Background="#B80F172A"
                        BorderBrush="#88FFFFFF"
                        BorderThickness="1.2">
                    <Grid>
                        <Path Data="M 16,12 L 32,22 L 16,32 Z"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Margin="8" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="RootBadge" Property="Background" Value="#E600A4DC" />
                        <Setter TargetName="RootBadge" Property="BorderBrush" Value="#FFFFFFFF" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="RootBadge" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
